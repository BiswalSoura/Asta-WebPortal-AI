ASTA_ENVIRONMENT=development
ASTA_APP_NAME=Asta
ASTA_API_V1_PREFIX=/api/v1
ASTA_LOG_LEVEL=INFO

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

DATABASE_URL=
TEST_DATABASE_URL=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
DOCUMENT_STORAGE_PATH=data/uploads

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

RETRIEVAL_TOP_K=8
RETRIEVAL_FINAL_K=4

RERANKER_MIN_SCORE=0.5

CONVERSATION_HISTORY_MESSAGES=6
CONVERSATION_CONTEXT_MAX_CHARS=4000

# Exact host origins only; configure after reviewing the M14 integration contract.
ASTA_CORS_ALLOWED_ORIGINS=[]
ASTA_CORS_EXPOSE_REQUEST_ID=false

# Temporary internal/demo administration; keep disabled outside approved local use.
KNOWLEDGE_ADMIN_API_ENABLED=false
KNOWLEDGE_ADMIN_TOKEN=
